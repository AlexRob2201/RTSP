            <widget class="QTableWidget" name="tableWidget">
             <property name="styleSheet">
              <string notr="true">QTableWidget {
    padding: 5px;
    border: 1px solid rgba(255, 255, 255, 40);
    border-radius: 7px;
	gridline-color: transparent;
}

QTableWidget::item {
    width: 30px;
    text-align: left;
    padding-left: 5px;
    background-color: rgba(255, 255, 255, 0);
	border-bottom: 1px solid rgba(255, 255, 255, 40);
}
QTableView::item:selected{
	color: rgb(255, 255, 255);
	font-weight:bold;
    background-color: rgba(42, 62, 73, 1);;
}
QTableWidget::item:first-child {
    border-left: 7px; /* Заокруглення для верхнього правого кута */
}

QTableWidget::item:last-child {
    border-right: 7px; /* Заокруглення для нижнього правого кута */
}

QHeaderView {
    background-color: rgba(255, 255, 255, 0);
    color: none; /* Виберіть color: black; або потрібний вам колір */
    margin: 0px;
    padding: 0px;
}

QHeaderView::section {
    background-color: rgba(255, 255, 255, 0);
    color: none; /* Виберіть color: white; або потрібний вам колір */
    border-bottom: 1px solid rgba(255, 255, 255, 40);
    border-radius: 7px;
    margin: 5px;
    padding: 2px;
}

QHeaderView::section:horizontal {
    background-color: rgba(42, 62, 73, 1);
    color: white;
    width: 30px;
    font-size: 12pt;
}

QHeaderView::section:vertical {
    background-color: rgba(42, 62, 73, 1);
    color: white;
    width: 20px;
    height: 50px;
    font-size: 12pt;
    text-align: center;
	padding-left: 12px;
}

QTableCornerButton::section {
    background-color: rgba(255, 255, 255, 0);
    border: none;
}

QTableCornerButton {
    background-color: rgba(255, 255, 255, 0);
    border: none;
}
</string>
